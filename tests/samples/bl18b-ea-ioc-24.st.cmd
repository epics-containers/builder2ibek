dbpf "BL18B-EA-PILAT-01:CAM:Temp0_RBV.LLSV" "MAJOR"
dbpf "BL18B-EA-PILAT-01:ARR:EnableCallbacks" "Enable"
dbpf "BL18B-EA-PILAT-01:HDF5:DeleteDriverFile" "No"
dbpf "BL18B-EA-PILAT-01:TIFF:DeleteDriverFile" "No"
dbpf "BL18B-EA-PILAT-01:NULL:DeleteDriverFile" "Yes"
dbpf "BL18B-EA-PILAT-01:NULL:Capture" "Capture"
dbpf "BL18B-EA-PILAT-01:NULL:LazyOpen" "Yes"
dbpf "BL18B-EA-PILAT-01:NULL:FileWriteMode" "Stream"
